# Public, same-origin browser path only. Never put API tokens in browser config.
# In production, set this to /api/prospecting and route it through a server-side proxy.
PROSPECTING_API_URL=

# Server-side proxy settings belong in the hosting platform's secret manager.
# These names are documented here without values; never expose them to the browser.
PROSPECTING_AGENT_API_URL=
PROSPECTING_AGENT_API_TOKEN=
PROSPECTING_APP_ORIGIN=

# Optional local development port.
PORT=4173

